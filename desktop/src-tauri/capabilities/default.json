{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Izin jendela utama. Seminimal mungkin (docs/20 §2e): tiap izin di sini adalah permukaan yang bisa dipanggil dari JS, jadi hanya yang sudah ada pemakainya. D2 (adapter platform) menambah izin fs/dialog seiring adapternya ditulis. Tidak ada deep-link dan tidak ada host login: v1 desktop tanpa login (docs/20 §1d).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://lib.kelasmalam.app/*"
        },
        {
          "url": "https://studio.kelasmalam.app/*"
        },
        {
          "url": "https://soundcloud.com/*"
        },
        {
          "url": "https://www.roblox.com/*"
        },
        {
          "url": "https://roblox.com/*"
        }
      ]
    },
    "updater:default"
  ]
}
