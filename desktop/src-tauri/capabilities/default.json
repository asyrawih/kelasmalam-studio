{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Izin jendela utama. Seminimal mungkin (docs/20 §2e): tiap izin di sini adalah permukaan yang bisa dipanggil dari JS, jadi hanya yang sudah ada pemakainya. D2 (adapter platform) menambah izin fs/dialog seiring adapternya ditulis. Tidak ada deep-link dan tidak ada host login: v1 desktop tanpa login (docs/20 §1d). Build produksi memuat frontend dari server loopback (lihat src/local_server.rs), jadi `remote.urls` mengizinkan origin http://127.0.0.1:<port> memakai izin ini; hanya WebView aplikasi yang punya jembatan IPC, jadi ini bukan pintu untuk proses lain.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-ping",
    "allow-store-info",
    "allow-store-relocate",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-clear",
    "allow-library-tracks",
    "allow-library-has",
    "allow-library-blob",
    "allow-library-put-bytes",
    "allow-library-import-path",
    "allow-library-commit",
    "allow-library-delete-track",
    "allow-library-put-marks",
    "allow-library-projects",
    "allow-library-project",
    "allow-library-project-create",
    "allow-library-project-update",
    "allow-library-project-delete",
    "allow-library-project-add-track",
    "allow-library-project-remove-track",
    "allow-roblox-taxonomy-list",
    "allow-roblox-category-upsert",
    "allow-roblox-category-delete",
    "allow-roblox-genre-upsert",
    "allow-roblox-genre-delete",
    "allow-roblox-queue-list",
    "allow-roblox-queue-put",
    "allow-roblox-queue-remove",
    "allow-roblox-upload-start",
    "allow-roblox-operation-poll",
    "allow-roblox-catalog-list",
    "allow-roblox-target-get",
    "allow-roblox-target-set",
    "allow-roblox-grant-settings-get",
    "allow-roblox-grant-cookie-set",
    "allow-roblox-grant-cookie-clear",
    "allow-roblox-assets-sync",
    "allow-roblox-assets-list",
    "allow-roblox-assets-import",
    "allow-roblox-assets-record",
    "allow-roblox-experiences",
    "allow-roblox-resolve-place",
    "allow-roblox-grant",
    "allow-soundcloud-json",
    "allow-soundcloud-bytes",
    "allow-model-download",
    "allow-model-read",
    "allow-youtube-status",
    "allow-youtube-setup",
    "allow-youtube-update",
    "allow-youtube-info",
    "allow-youtube-bytes",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://lib.kelasmalam.app/*"
        },
        {
          "url": "https://studio.kelasmalam.app/*"
        },
        {
          "url": "https://soundcloud.com/*"
        },
        {
          "url": "https://www.roblox.com/*"
        },
        {
          "url": "https://roblox.com/*"
        }
      ]
    },
    "updater:default"
  ]
}
