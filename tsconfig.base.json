{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    /* Strict penuh + beberapa cek tambahan yang relevan untuk kode audio:
       akses index buffer harus dianggap bisa undefined (noUncheckedIndexedAccess)
       karena banyak jalur di sini membaca view yang panjangnya bisa 0 setelah
       memory.grow (docs/05). */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    /* SATU sumber alias untuk seluruh workspace (docs/25 P1).

       Paket-paket dikonsumsi sebagai SUMBER TypeScript, tanpa build step, jadi
       `@kelasmalam/engine/audio/x` harus menunjuk langsung ke berkas .ts-nya.
       `workspace-aliases.ts` di root menurunkan alias Vite/Vitest dari daftar
       ini, dan `apps/web/src/__tests__/workspace-aliases.test.ts` memastikan
       keduanya tidak pernah berbeda — kalau tsc dan Vite meresolusi ke berkas
       yang berbeda, typecheck hijau tidak membuktikan apa-apa tentang bundel.

       Tidak ada alias ke `apps/*`: sejak P3 semua modul halaman adalah paket,
       dan `apps/desktop/src/__tests__/app-web-imports.test.ts` menjaga alias
       sementara P2 itu tidak pernah kembali. */
    "baseUrl": ".",
    "paths": {
      "@kelasmalam/engine/*": ["packages/engine/src/*"],
      "@kelasmalam/ui/*": ["packages/ui/src/*"],
      "@kelasmalam/shell": ["packages/shell/src/index.ts"],
      "@kelasmalam/shell/*": ["packages/shell/src/*"],
      "@kelasmalam/platform": ["packages/platform/src/index.ts"],
      "@kelasmalam/platform/*": ["packages/platform/src/*"],
      "@kelasmalam/studio/*": ["packages/studio/src/*"],
      "@kelasmalam/dj/*": ["packages/dj/src/*"],
      "@kelasmalam/library/*": ["packages/library/src/*"],
      "@kelasmalam/roblox/*": ["packages/roblox/src/*"],
      "@kelasmalam/soundcloud/*": ["packages/soundcloud/src/*"],
      "@kelasmalam/proof-stem/*": ["packages/proof-stem/src/*"]
    }
  }
}
