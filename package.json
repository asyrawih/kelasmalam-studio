{
  "name": "dawonweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run build:wasm && bun run --cwd apps/web build",
    "build:wasm": "./scripts/build-wasm.sh",
    "preview": "bun run --cwd apps/web preview",
    "dev:desktop": "cd desktop/src-tauri && cargo tauri dev",
    "build:desktop": "bun run build:wasm && bun run --cwd apps/web build && cd desktop/src-tauri && cargo tauri build",
    "test": "bun run test:rust && bun run --cwd apps/web test && bun run --cwd backend test",
    "test:rust": "cargo test --workspace",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --check",
    "size-check": "./scripts/size-check.sh",
    "clean": "cargo clean && rm -rf packages/engine/src/wasm apps/web/dist"
  }
}
