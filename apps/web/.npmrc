# `vitest-canvas-mock@1.1.5` mendeklarasikan peer `vitest` yang sudah tertinggal
# dari versi yang kita pakai (2.1.x). Paketnya sendiri BEKERJA — seluruh tes
# canvas hijau dengannya — yang usang hanya rentang peer di manifest-nya.
#
# `npm install` lokal memaafkan itu, `npm ci` di CI tidak. Tanpa berkas ini,
# CI gagal karena alasan yang tidak ada hubungannya dengan kode.
#
# Kalau paketnya nanti memperbarui peer range (atau diganti stub buatan
# sendiri), baris ini yang pertama harus dibuang.
legacy-peer-deps=true
