{
  "extends": "../../tsconfig.base.json",
  /* `../*\/src/*.d.ts`: deklarasi ambient milik paket lain (shim modul tanpa
     tipe di engine, `?worklet&url`, ORT di proof-stem, `ImportMetaEnv` per
     paket). `tsc -p` paket ini menarik sumber paket yang diimpornya, dan sumber
     itu mengandalkan deklarasi ambient di sampingnya yang TIDAK ikut tertarik
     lewat impor. App menyertakan `packages/*\/src` utuh, jadi tidak butuh ini. */
  "include": ["src", "../*/src/*.d.ts"]
}
